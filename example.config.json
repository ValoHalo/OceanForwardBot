{
  "bot": {
    "token": "YOUR_BOT_TOKEN_HERE",
    "owner_id": 123456789,
    "proxy_url": "",
    "silent_forwarding": false,
    "log_level": "INFO"
  },
  "watchdog": {
    "restart_delay_s": 5,
    "max_consecutive_restarts": 5,
    "stable_reset_s": 600
  },
  "network": {
    "connection_pool_size": 32,
    "read_timeout": 20.0,
    "connect_timeout": 10.0,
    "pool_timeout": 10.0,
    "write_timeout": 20.0,
    "media_write_timeout": 60.0,
    "max_concurrent_sends": 4,
    "max_retries": 3,
    "retry_base_delay_s": 1.0,
    "media_group_wait_s": 2.0
  },
  "message_processing": {
    "url_rewrites": [
      {
        "name": "fxtwitter",
        "enabled": true,
        "source_hosts": [
          "x.com",
          "www.x.com",
          "twitter.com",
          "www.twitter.com"
        ],
        "target_host": "fxtwitter.com",
        "path_pattern": "^/(?:i/status/[0-9]+|[^/]+/status/[0-9]+)(?:/.*)?$",
        "strip_query": true,
        "strip_fragment": true
      },
      {
        "name": "phixiv",
        "enabled": true,
        "source_hosts": [
          "pixiv.net",
          "www.pixiv.net"
        ],
        "target_host": "www.phixiv.net",
        "path_pattern": "^/(?:[a-z]{2}/)?artworks/[0-9]+(?:/[0-9]+(?:-[0-9]+)?)?$",
        "strip_query": true,
        "strip_fragment": true
      }
    ]
  },
  "destinations": [
    {
      "chat_id": -1001234567890,
      "topic_ids": []
    },
    {
      "chat_id": -1005555555555,
      "topic_ids": [1, 2],
      "silent_forwarding": true
    }
  ]
}
